// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id         String   @id @default(uuid())
  email      String   @unique
  firstName  String
  lastName   String
  password   String
  role       Role     @default(CITIZEN)

  availability Boolean @default(true)
  specialty     String?
  zone          String?
  crew          String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  reports    Report[]

  technicianAssignments ReportAssignment[] @relation("TechnicianAssignments")
  operatorAssignments   ReportAssignment[] @relation("OperatorAssignments")
}

enum Role {
  CITIZEN
  OPERATOR
  TECHNICIAN
}


model Report {
  id             String   @id @default(uuid())
  category       ReportCategory
  problemType    String

  categoryId     String?
  categoryRef    Category? @relation(fields: [categoryId], references: [id])

  problemTypeId  String?
  problemTypeRef ProblemType? @relation(fields: [problemTypeId], references: [id])

  description    String
  latitude      Float?
  longitude     Float?
  address      String?
  isAnonymous    Boolean @default(false)
  status         Status @default(REGISTERED)
  userId         String
  user           User @relation(fields: [userId], references: [id])
  evidences     ReportEvidence[]
  assignments ReportAssignment[]

  priority       Priority?
  impact         String?
  probability    String?
  operationalType String?
  targetDate     DateTime?
  justification  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([userId])
}

model ReportEvidence {
  id         String   @id @default(uuid())
  imageUrl   String
  reportId   String
  report     Report @relation(fields: [reportId], references: [id])
  createdAt  DateTime @default(now())
  @@index([reportId])
}

model ReportAssignment {
  id             String   @id @default(uuid())

  reportId        String
  technicianId    String
  assignedById    String

  assignedAt      DateTime @default(now())

  notes           String?

  active          Boolean @default(true)

  report           Report @relation(fields: [reportId], references: [id])

  technician User @relation("TechnicianAssignments", fields: [technicianId], references: [id])

  assignedBy User @relation("OperatorAssignments", fields: [assignedById], references: [id])

  @@index([reportId])
  @@index([technicianId])
  @@index([assignedById])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  problemTypes ProblemType[]
  reports      Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProblemType {
  id          String   @id @default(uuid())
  name        String
  description String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  reports Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClosureReason {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SlaConfiguration {
  id String @id @default(uuid())

  priority Priority @unique

  responseHours Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


enum Status {
  REGISTERED
  VALIDATING
  APPROVED
  REJECTED
  PRIORITIZED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
}

enum ReportCategory {
  SECURITY
  ENVIRONMENT
  INFRASTRUCTURE
  MOBILITY
}
enum Priority {
  BAJO
  MEDIO
  ALTO
}